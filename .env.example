# Semantic Scholar API Key (optional but recommended for higher rate limits)
# Get your API key from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_api_key_here

# Zotero Integration (optional - for bibliography management)
# Get your credentials from: https://www.zotero.org/settings/keys
# User ID can be found in your Zotero profile URL or account settings
ZOTERO_USER_ID=your_zotero_user_id_here
ZOTERO_API_KEY=your_zotero_api_key_here